# 内网宿主机ip
INTERNAL_IP=192.168.31.80

# rocketmq name server版本号
RMQ_NAME_SERVER_VERSION=4.8.0
# rocketmq name server容器名称
RMQ_NAME_SERVER_CONTAINER_NAME=backend-micro-rmqnamesrv-v1
# rocketmq name server数据挂载目录
RMQ_NAME_SERVER_DIR=./rmqnamesrv
# rocketmq name server端口号
RMQ_NAME_SERVER_REAL_PORT=9876

# rocketmq broker版本号
RMQ_BROKER_VERSION=4.8.0
# rocketmq broker容器名称
RMQ_BROKER_CONTAINER_NAME=backend-micro-rmqbroker-v1
# rocketmq broker数据挂载目录
RMQ_BROKER_DIR=./rmqbroker
# rocketmq broker listen端口号
RMQ_BROKER_LISTEN_PORT=10911
# rocketmq broker fast listen端口号（须为listen端口号-2）
RMQ_BROKER_FAST_LISTEN_PORT=10909

# rocketmq console版本号
RMQ_CONSOLE_VERSION=1.0.1
# rocketmq console容器名称
RMQ_CONSOLE_CONTAINER_NAME=backend-micro-rmqconsole-v1
# rocketmq console数据挂载目录
RMQ_CONSOLE_DIR=./rmqconsole
# rocketmq console端口号
RMQ_CONSOLE_REAL_PORT=8180