# minio版本号
MINIO_VERSION=RELEASE.2021-07-30T00-02-00Z.fips
# minio容器名称
MINIO_CONTAINER_NAME=backend-micro-minio-v1
# minio数据挂载目录
MINIO_DIR=./minio
# minio服务端口号
MINIO_SERVER_PORT=9000
# minio终端端口号
MINIO_CONSOLE_PORT=9001
# minio超级用户名称（长度大于3）
MINIO_ROOT_USER=minio
# minio超级用户密码（长度大于8）
MINIO_ROOT_PASSWORD=minio123456
