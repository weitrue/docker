# 内网宿主机ip
INTERNAL_IP=0.0.0.0

# mysql版本号
MYSQL_VERSION=5.7.31
# mysql容器名称
MYSQL_CONTAINER_NAME=mysql-v5.7.31
# mysql数据挂载目录
MYSQL_DIR=./mysql
# mysql端口号
MYSQL_REAL_PORT=3306
# mysql超级用户密码
MYSQL_ROOT_PASSWORD=123123
# mysql超级用户允许地址
MYSQL_ROOT_HOST=%

# redis版本号
REDIS_VERSION=4.0.14
# redis容器名称
REDIS_CONTAINER_NAME=redis-v4.0.14
# redis数据挂载目录
REDIS_DIR=./redis
# redis端口号
REDIS_REAL_PORT=6379
# redis连接密码
REDIS_PASSWORD=

# pg DB
POSTGRES_DB=postgres
# pg user
POSTGRES_USER=postgres
# pg user password
POSTGRES_PASSWORD=123456
# pg DB data
POSTGRES_DIR=./postgres
# pg DB port
POSTGRES_PORT=5438

# etcd版本号
ETCD_VERSION=v3.4.14
# etcd容器名称
ETCD_CONTAINER_NAME=etcd-v3.4.14
# etcd数据挂载目录
ETCD_DIR=./etcd
# etcd客户端连接端口号
ETCD_REAL_CLIENT_PORT=2379
# etcd节点连接端口号
ETCD_REAL_PEER_PORT=2380
# etcd节点名称
ETCD_NAME=s1
# etcd初始化令牌
ETCD_TOKEN=token

# apollo版本号
APOLLO_VERSION=1.7.1
# apollo容器名称
APOLLO_CONTAINER_NAME=apollo-v1.7.1
# apollo数据挂载目录
APOLLO_DIR=./apollo
# apollo portal服务端口
APOLLO_PORTAL_PORT=8070
# apollo dev config服务端口
APOLLO_DEV_CONFIG_PORT=8080
# apollo dev admin服务端口
APOLLO_DEV_ADMIN_PORT=8090

# elasticsearch版本号
ELASTIC_SEARCH_VERSION=7.17.5
# elasticsearch容器名称
ELASTIC_SEARCH_NAME=es-v7.17.5
# elasticsearch数据挂载目录
ELASTIC_SEARCH_DIR=./es
# elasticsearch服务端口
ELASTIC_SEARCH_SERVER_PORT=9200
# elasticsearch内部节点通讯端口
ELASTIC_SEARCH_INNER_PORT=9300

# elasticsearch-head版本号
ELASTIC_SEARCH_HEAD_VERSION=5-alpine
# elasticsearch-head容器名称
ELASTIC_SEARCH_HEAD_NAME=es-head-5-alpine
# elasticsearch-head数据挂载目录
ELASTIC_SEARCH_HEAD_DIR=./es-head
# elasticsearch-head服务端口
ELASTIC_SEARCH_HEAD_SERVER_PORT=9100